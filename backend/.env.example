SECRET_KEY=your-secret-key-here
DEBUG=True

# ── Database (use either DATABASE_URL or the split variables) ────────────────
DATABASE_URL=postgres://user:password@localhost:5432/taskmanager_db
DB_NAME=taskmanager_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# ── Hosts / CORS ─────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend URL (used in verification-email links) ──────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email — Resend (production) ───────────────────────────────────────────────
# Set RESEND_API_KEY to enable Resend sending.
# When this variable is absent/empty Django falls back to the console backend
# (emails are printed to stdout — good for local dev, useless in production).
#
# 1. Sign up at https://resend.com and create an API key.
# 2. Verify a sender domain OR use onboarding@resend.dev for initial testing
#    (sandbox sender — can only deliver to the Resend account's own email).
# 3. Set DEFAULT_FROM_EMAIL to a verified sender address on your domain, e.g.:
#    ProjectFlow <noreply@yourdomain.com>
#    For sandbox testing you may use: ProjectFlow <onboarding@resend.dev>
#
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=ProjectFlow <onboarding@resend.dev>

# ── Obsolete Gmail SMTP variables — no longer required ───────────────────────
# These were used by the old Gmail SMTP backend and can be removed from Render.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
